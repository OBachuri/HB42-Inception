# DOMAIN NAME
# ==============================================================================
DOMAIN_NAME=obachuri.42.fr

# MARIADB CONFIG
# ==============================================================================
MARIADB_WP_DATABASE=wp

MARIADB_ADMIN_USER=mdbodmin
MARIADB_WP_USER=wpdbuser

MARIADB_ROOT_PASSWORD_HOST_FILE=../secrets/db_root_password.txt
MARIADB_ADMIN_PASSWORD_HOST_FILE=../secrets/db_admin_password.txt
MARIADB_WP_USER_PASSWORD_HOST_FILE=../secrets/db_wp_user_password.txt

# WORDPRESS CONFIG
# ==============================================================================
WP_TITLE=Inception

WP_PHP_VERSION=8.5
WP_VERSION=7.1
# https://wordpress.org/wordpress-7.1.zip

WP_DB_HOST=mariadb:3306
WP_DB_NAME=$MARIADB_WP_DATABASE
WP_DB_USER=$MARIADB_WP_USER


WP_ADMIN_USER=obachuri
WP_ADMIN_EMAIL=obachuri@student.42.fr
WP_ADMIN_PASSWORD_HOST_FILE=../secrets/wp_admin_password.txt

WP_USER=simpleuser
WP_USER_EMAIL=simpleuser@student.42.fr
WP_USER_PASSWORD_HOST_FILE=../secrets/wp_user_password.txt

WP_REDIS_HOST=redis
WP_REDIS_PORT=6379



# NGINX CONFIG
# ==============================================================================
# one port to inside and outside
NGINX_PORT=4443
# NGINX_SSL_CERTIFICATE_HOST_FILE=../secrets/certs/inception_nginx.crt
# NGINX_SSL_CERTIFICATE_FILE=/run/secrets/nginx_cert

# NGINX_SSL_CERTIFICATE_KEY_HOST_FILE=../secrets/certs/inception_nginx.key
# NGINX_SSL_CERTIFICATE_KEY_FILE=/run/secrets/nginx_key


# FTP CONFIG
# ==============================================================================
FTP_USER=$WP_ADMIN_USER
FTP_USER_PASSWORD_HOST_FILE=../secrets/ftp_user_password.txt

# Adminer - SQL 
# ==============================================================================
A_PHP_VERSION=8.5
ADMINER_VERSION=6.1.0

# mariadb explorer
MARIADB_EXPLORER_HOST_FILE=../secrets/mariadb_exporter_password.txt
